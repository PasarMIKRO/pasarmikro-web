---
// Embedded crop and climate insurance page (EN). Ported from the approved design canvas
// (review of 25 Nov 2026). Partner names and fees stay off the page until the agreement is signed.
import { env } from 'cloudflare:workers';
import farmerRio from '../../assets/img/insurance/farmer-rio.jpg';
import riceHarvest from '../../assets/img/insurance/rice-harvest.jpg';
import fieldVisit from '../../assets/img/insurance/field-visit.jpg';
import farmerThumbs from '../../assets/img/insurance/farmer-thumbs.jpg';
import { site } from '../../lib/site';

interface Props {
  proof: { value: string; unit?: string; label: string }[];
}
const { proof } = Astro.props;
const siteKey = env.TURNSTILE_SITE_KEY;
const waHref = `https://wa.me/${site.whatsapp}`;
---

<div class="insurance" style="background: #FFFFFF; color: #101828; width: 100%; overflow-x: hidden">
<!-- HERO -->
<section id="hero" style="background: radial-gradient(120% 140% at 30% 20%, #006386 0%, #004259 55%, #003143 100%); color: #FFFFFF; padding: 64px 0 88px">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">Embedded insurance · For insurers and programme partners</div>
<h1 style="font-size: 50px; line-height: 1.08; font-weight: 800; letter-spacing: -0.03em; color: #FFFFFF">Crop and climate insurance that reaches smallholders through the trade they already do.</h1>
<p style="font-size: 19px; line-height: 1.6; color: #C0E5F2; max-width: 580px">PasarMIKRO builds insurance into the trade, payment and supply chain workflows farmers already use on our platform. We run farmer registration, plot mapping, claims and payouts digitally, so licensed insurers reach more smallholders at lower cost, and farmers are paid faster after a bad season.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px"><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 18px; font-weight: 800; color: #FFFFFF">Insurer-agnostic</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">Works with any licensed insurer and product</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 18px; font-weight: 800; color: #FFFFFF">End-to-end digital</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">From registration to claim payout</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 18px; font-weight: 800; color: #FFFFFF">Real trade data</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">Verification backed by transaction records</div></div></div>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a href="#partner" style="background: #FDB022; color: #003143; text-decoration: none; font-weight: 800; font-size: 17px; padding: 15px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center">Make an enquiry</a>
<a href="#how" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 22px; border-radius: 10px; border: 1.5px solid #2E7290; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center">See how it works</a>
</div>
</div>
<div style="flex: 1 1 400px; min-width: 0; max-width: 540px; position: relative">
<img src={farmerRio.src} alt="A rice farmer who sells through PasarMIKRO, standing in his paddy field" style="width: 100%; height: 480px; object-fit: cover; object-position: center 25%; border-radius: 24px; display: block">
<div style="position: absolute; left: 20px; right: 20px; bottom: 20px; background: #FFFFFF; border-radius: 16px; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 16px 40px rgba(0,0,0,0.3)">
<div style="font-size: 13px; font-weight: 700; color: #006386">First pilot · crop and climate insurance</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px"><div><div style="font-size: 22px; font-weight: 800; color: #003143">~500</div><div style="font-size: 13px; color: #475467">rice farmers</div></div><div><div style="font-size: 22px; font-weight: 800; color: #003143">~250 ha</div><div style="font-size: 13px; color: #475467">of rice paddy</div></div><div><div style="font-size: 22px; font-weight: 800; color: #003143">6 months</div><div style="font-size: 13px; color: #475467">per pilot phase</div></div></div>
</div>
</div>
</div>
</section>

<section aria-label="PasarMIKRO" style="background: #FFFFFF; border-bottom: 1px solid #EAECF0">
<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px 0"><h2 style="font-size: 22px; line-height: 1.3; font-weight: 800; color: #003143">PasarMIKRO today: the trade network insurance plugs into</h2><p style="font-size: 15px; color: #475467; margin-top: 6px">Insurance is offered through the platform farmers, traders and businesses already use every day.</p></div>
<dl style="max-width: 1200px; margin: 0 auto; padding: 24px 20px 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px">{proof.map((p) => (<div style="display: flex; flex-direction: column-reverse; gap: 4px"><dt style="font-size: 14px; color: #475467">{p.label}</dt><dd style="margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: #006386">{p.value}{p.unit && <span style="font-size: 16px; font-weight: 600; color: #475467; margin-left: 6px">{p.unit}</span>}</dd></div>))}</dl>
</section>

<!-- PROBLEM -->
<section id="problem" style="padding: 96px 0; background: #ECF9FE">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center">
<div style="flex: 1 1 520px; min-width: 0">
<div style="font-size: 15px; font-weight: 700; color: #006386">The problem</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #003143; max-width: 780px">Why standalone farm insurance struggles to reach smallholders</h2>
<p style="font-size: 18px; line-height: 1.65; color: #475467; margin-top: 18px">Crop and climate insurance protects farmers when a season fails. But when it is sold on its own, one farmer at a time and separate from their daily business, it keeps running into the same structural problems.</p>
</div>
<figure style="flex: 1 1 360px; min-width: 0; margin: 0">
<img src={riceHarvest.src} alt="Two farmers in woven hats harvesting rice, with part of the crop lying flattened in the field" style="width: 100%; height: 300px; object-fit: cover; border-radius: 20px; display: block">
<figcaption style="font-size: 12px; color: #475467; margin-top: 8px">Rice farmers at harvest. Photo: PasarMIKRO.</figcaption>
</figure>
</div>
<p style="margin-top: 40px; font-size: 28px; line-height: 1.3; font-weight: 800; letter-spacing: -0.015em; color: #003143; max-width: 900px; border-left: 6px solid #FDB022; padding-left: 20px">One flood, drought or pest outbreak can wipe out a smallholder's whole season, and the income that comes with it.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 28px"><div style="background: #FFFFFF; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M17 11l2 2 4-4"></path></svg></div><h3 style="font-size: 19px; font-weight: 800">Low uptake</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Many farmers do not know crop insurance exists or how it works, so few seek it out. Reaching them one by one is slow and expensive.</p></div><div style="background: #FFFFFF; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></div><h3 style="font-size: 19px; font-weight: 800">High operating costs</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Registering, verifying and servicing thousands of small policies by hand often costs more than the premiums bring in. Insurers lose money on them, or premiums end up too high for farmers.</p></div><div style="background: #FFFFFF; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"></path><path d="M9 15l2 2 4-4"></path></svg></div><h3 style="font-size: 19px; font-weight: 800">Slow claims and payouts</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Paper claims, field visits and manual checks delay payouts just when farmers need cash most.</p></div></div>
<div style="margin-top: 20px; background: #003143; color: #FFFFFF; border-radius: 18px; padding: 28px 30px; display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: center">
<h3 style="flex: 1 1 300px; font-size: 26px; line-height: 1.2; font-weight: 800; color: #FFFFFF">The fix: insurance inside the ecosystem</h3>
<p style="flex: 2 1 460px; font-size: 17px; line-height: 1.6; color: #ECF9FE">When insurance is part of the trade, finance and supply chain workflows farmers already use, backed by digital infrastructure and real transaction data, these problems disappear. Farmers are better protected, risk falls for insurers and funders, and programmes can scale and last.</p>
</div>
<div style="margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px"><p style="font-size: 18px; font-weight: 700; color: #003143; flex: 0 1 auto">Want to reach more farmers at lower cost?</p><a href="#partner" style="background: #FDB022; color: #003143; text-decoration: none; font-weight: 800; font-size: 16px; padding: 13px 22px; border-radius: 10px; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Make an enquiry</a><a href="https://wa.me/6285157570025?text=Hi%20PasarMIKRO%2C%20I%20would%20like%20to%20talk%20about%20embedded%20insurance.%20%28Sent%20from%20the%20embedded%20insurance%20page%29" target="_blank" rel="noopener" style="color: #006386; font-weight: 700; font-size: 15px; min-height: 44px; display: inline-flex; align-items: center">or chat on WhatsApp</a></div>
</div>
</section>

<!-- PLATFORM -->
<section id="platform" style="padding: 96px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="font-size: 15px; font-weight: 700; color: #006386">What we do</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #003143; max-width: 780px">One insurer-agnostic platform for the whole insurance cycle</h2>
<p style="font-size: 18px; line-height: 1.65; color: #475467; margin-top: 18px; max-width: 760px">We design, run and maintain the digital workflows and field operations around the policy. The insurer keeps the product, the terms and the underwriting.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; margin-top: 40px"><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M17 11l2 2 4-4"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Farmer onboarding and verification</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Digital farmer registration, identity verification (KYC) and data validation, coordinated with farmer groups, aggregators and cooperatives.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></div><h3 style="font-size: 20px; font-weight: 800">Plot mapping and coverage</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Our field team helps farmers map their plots, so the insured area matches the land actually farmed, and keeps coverage status up to date during the season.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"></path><path d="M9 15l2 2 4-4"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Claim intake and verification</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Digital claim submission, deadline and completeness tracking, and verification with agronomy data, farm devices or field checks, documented for the insurer.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="13" rx="2"></rect><path d="M2 10h20"></path><path d="M6 15h4"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Payout channelling</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Approved payouts go straight to farmers' own accounts, with reconciliation and payment reports for the insurer.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Dashboards and reporting</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Live dashboards for insurers, programmes and funders: active farmers, production, and premiums against claims, plus donor reporting.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="2.5"></circle><circle cx="5" cy="19" r="2.5"></circle><circle cx="19" cy="19" r="2.5"></circle><path d="M12 7.5v4M12 11.5l-5.5 5.5M12 11.5l5.5 5.5"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Built on an active trade network</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Farmers already trade, get paid and map plots on PasarMIKRO for traceability and EUDR, so insurance plugs into records that already exist.</p></div></div>
<div style="margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px"><p style="font-size: 18px; font-weight: 700; color: #003143; flex: 0 1 auto">Need one or more of these services?</p><a href="#partner" style="background: #FDB022; color: #003143; text-decoration: none; font-weight: 800; font-size: 16px; padding: 13px 22px; border-radius: 10px; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Make an enquiry</a><a href="https://wa.me/6285157570025?text=Hi%20PasarMIKRO%2C%20I%20would%20like%20to%20talk%20about%20embedded%20insurance.%20%28Sent%20from%20the%20embedded%20insurance%20page%29" target="_blank" rel="noopener" style="color: #006386; font-weight: 700; font-size: 15px; min-height: 44px; display: inline-flex; align-items: center">or chat on WhatsApp</a></div>
</div>
</section>

<!-- HOW IT WORKS -->
<section id="how" style="background: #003143; color: #FFFFFF; padding: 96px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">How it works</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #FFFFFF; max-width: 780px">How embedded crop insurance works on PasarMIKRO</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-top: 40px"><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">01</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Register and verify</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Farmers are registered and verified digitally, often through their group or the trader they already sell to.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">02</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Map and cover</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Plots are mapped and shared with the insurer, who sets the product, terms and premium.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">03</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Monitor the season</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Coverage is tracked through the season and updated if the farmed area changes.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">04</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Claim</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">After a loss, the claim is submitted digitally and verified with field, agronomy or device data.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">05</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Payout</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">The insurer approves the claim and the payout reaches the farmer's account, fully reconciled.</p></div></div>
<div style="margin-top: 28px; background: #00283A; border: 1px solid #1D5A72; border-radius: 18px; padding: 28px 24px 20px">
<h3 style="font-size: 24px; font-weight: 800; color: #FFFFFF">How data and payouts move</h3>
<div style="overflow-x: auto; margin-top: 12px"><svg viewBox="0 0 1100 430" role="img" aria-label="Diagram: farmers send registration, plot and claim data to the PasarMIKRO platform, which passes verified data and claims to the licensed insurer. The insurer sends approved payouts, which PasarMIKRO channels to farmers' accounts. Programmes and funders receive dashboards and reports." style="width: 100%; min-width: 720px; height: auto; display: block; font-family: inherit">
<defs><marker id="ag-en" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#FDB022"></path></marker><marker id="ad-en" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#7CD4FD"></path></marker><marker id="ar-en" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#98A2B3"></path></marker></defs>
<rect x="410" y="24" width="280" height="104" rx="16" fill="#003143" stroke="#FDB022" stroke-width="3"></rect>
<text x="550" y="68" text-anchor="middle" font-size="22" font-weight="800" fill="#FFFFFF">PasarMIKRO</text>
<text x="550" y="96" text-anchor="middle" font-size="15" font-weight="600" fill="#FDB022">Insurance platform</text>
<rect x="30" y="320" width="260" height="86" rx="14" fill="#004259" stroke="#2E7290" stroke-width="1.5"></rect><text x="160" y="358" text-anchor="middle" font-size="21" font-weight="800" fill="#FFFFFF">Farmers</text><text x="160" y="384" text-anchor="middle" font-size="13" fill="#C0E5F2">smallholders and farmer groups</text>
<rect x="420" y="320" width="260" height="86" rx="14" fill="#004259" stroke="#2E7290" stroke-width="1.5"></rect><text x="550" y="358" text-anchor="middle" font-size="21" font-weight="800" fill="#FFFFFF">Programmes & partners</text><text x="550" y="384" text-anchor="middle" font-size="13" fill="#C0E5F2">funders, government, institutions</text>
<rect x="810" y="320" width="260" height="86" rx="14" fill="#004259" stroke="#2E7290" stroke-width="1.5"></rect><text x="940" y="358" text-anchor="middle" font-size="21" font-weight="800" fill="#FFFFFF">Insurer</text><text x="940" y="384" text-anchor="middle" font-size="13" fill="#C0E5F2">licensed; sets terms, pays claims</text>
