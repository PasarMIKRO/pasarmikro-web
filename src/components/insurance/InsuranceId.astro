---
// Embedded crop and climate insurance page (ID). Ported from the approved design canvas
// (review of 25 Nov 2026). Partner names and fees stay off the page until the agreement is signed.
import { env } from 'cloudflare:workers';
import farmerRio from '../../assets/img/insurance/farmer-rio.jpg';
import riceHarvest from '../../assets/img/insurance/rice-harvest.jpg';
import fieldVisit from '../../assets/img/insurance/field-visit.jpg';
import farmerThumbs from '../../assets/img/insurance/farmer-thumbs.jpg';
import { site } from '../../lib/site';

interface Props {
  proof: { value: string; unit?: string; label: string }[];
}
const { proof } = Astro.props;
const siteKey = env.TURNSTILE_SITE_KEY;
const waHref = `https://wa.me/${site.whatsapp}`;
---

<div class="insurance" style="background: #FFFFFF; color: #101828; width: 100%; overflow-x: hidden">
<!-- HERO -->
<section id="hero" style="background: radial-gradient(120% 140% at 30% 20%, #006386 0%, #004259 55%, #003143 100%); color: #FFFFFF; padding: 64px 0 88px">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">Asuransi terintegrasi · Untuk perusahaan asuransi dan mitra program</div>
<h1 style="font-size: 50px; line-height: 1.08; font-weight: 800; letter-spacing: -0.03em; color: #FFFFFF">Asuransi tanaman dan iklim yang menjangkau petani kecil lewat perdagangan yang sudah mereka jalankan.</h1>
<p style="font-size: 19px; line-height: 1.6; color: #C0E5F2; max-width: 580px">PasarMIKRO menyatukan asuransi dengan alur perdagangan, pembayaran dan rantai pasok yang sudah dipakai petani di platform kami. Pendaftaran petani, pemetaan lahan, klaim dan pencairan kami jalankan secara digital, sehingga perusahaan asuransi berizin menjangkau lebih banyak petani kecil dengan biaya lebih rendah, dan petani menerima pembayaran lebih cepat setelah gagal panen.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px"><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 18px; font-weight: 800; color: #FFFFFF">Tidak terikat penanggung</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">Bisa dengan perusahaan asuransi berizin mana pun</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 18px; font-weight: 800; color: #FFFFFF">Digital dari awal hingga akhir</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">Dari pendaftaran hingga pencairan klaim</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 18px; font-weight: 800; color: #FFFFFF">Data transaksi nyata</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">Verifikasi didukung catatan transaksi</div></div></div>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a href="#partner" style="background: #FDB022; color: #003143; text-decoration: none; font-weight: 800; font-size: 17px; padding: 15px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center">Kirim pertanyaan</a>
<a href="#how" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 22px; border-radius: 10px; border: 1.5px solid #2E7290; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center">Lihat cara kerjanya</a>
</div>
</div>
<div style="flex: 1 1 400px; min-width: 0; max-width: 540px; position: relative">
<img src={farmerRio.src} alt="Petani padi yang menjual lewat PasarMIKRO, berdiri di sawahnya" style="width: 100%; height: 480px; object-fit: cover; object-position: center 25%; border-radius: 24px; display: block">
<div style="position: absolute; left: 20px; right: 20px; bottom: 20px; background: #FFFFFF; border-radius: 16px; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 16px 40px rgba(0,0,0,0.3)">
<div style="font-size: 13px; font-weight: 700; color: #006386">Proyek percontohan pertama · asuransi tanaman dan iklim</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px"><div><div style="font-size: 22px; font-weight: 800; color: #003143">±500</div><div style="font-size: 13px; color: #475467">petani padi</div></div><div><div style="font-size: 22px; font-weight: 800; color: #003143">±250 ha</div><div style="font-size: 13px; color: #475467">lahan sawah</div></div><div><div style="font-size: 22px; font-weight: 800; color: #003143">6 bulan</div><div style="font-size: 13px; color: #475467">per tahap</div></div></div>
</div>
</div>
</div>
</section>

<section aria-label="PasarMIKRO" style="background: #FFFFFF; border-bottom: 1px solid #EAECF0">
<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px 0"><h2 style="font-size: 22px; line-height: 1.3; font-weight: 800; color: #003143">PasarMIKRO saat ini: jaringan dagang tempat asuransi tersambung</h2><p style="font-size: 15px; color: #475467; margin-top: 6px">Asuransi ditawarkan lewat platform yang sudah dipakai petani, pedagang dan pelaku usaha setiap hari.</p></div>
<dl style="max-width: 1200px; margin: 0 auto; padding: 24px 20px 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px">{proof.map((p) => (<div style="display: flex; flex-direction: column-reverse; gap: 4px"><dt style="font-size: 14px; color: #475467">{p.label}</dt><dd style="margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: #006386">{p.value}{p.unit && <span style="font-size: 16px; font-weight: 600; color: #475467; margin-left: 6px">{p.unit}</span>}</dd></div>))}</dl>
</section>

<!-- PROBLEM -->
<section id="masalah" style="padding: 96px 0; background: #ECF9FE">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center">
<div style="flex: 1 1 520px; min-width: 0">
<div style="font-size: 15px; font-weight: 700; color: #006386">Masalahnya</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #003143; max-width: 780px">Mengapa asuransi pertanian mandiri sulit menjangkau petani kecil</h2>
<p style="font-size: 18px; line-height: 1.65; color: #475467; margin-top: 18px">Asuransi tanaman dan iklim melindungi petani saat panen gagal. Namun jika dijual sebagai produk tersendiri, satu petani demi satu petani dan terpisah dari usaha hariannya, asuransi terus menghadapi masalah struktural yang sama.</p>
</div>
<figure style="flex: 1 1 360px; min-width: 0; margin: 0">
<img src={riceHarvest.src} alt="Dua petani bercaping memanen padi, sebagian tanaman rebah di sawah" style="width: 100%; height: 300px; object-fit: cover; border-radius: 20px; display: block">
<figcaption style="font-size: 12px; color: #475467; margin-top: 8px">Petani padi saat panen. Foto: PasarMIKRO.</figcaption>
</figure>
</div>
<p style="margin-top: 40px; font-size: 28px; line-height: 1.3; font-weight: 800; letter-spacing: -0.015em; color: #003143; max-width: 900px; border-left: 6px solid #FDB022; padding-left: 20px">Satu kali banjir, kekeringan atau serangan hama bisa menghapus hasil satu musim petani kecil, beserta pendapatan yang menyertainya.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 28px"><div style="background: #FFFFFF; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M17 11l2 2 4-4"></path></svg></div><h3 style="font-size: 19px; font-weight: 800">Minat rendah</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Banyak petani belum tahu ada asuransi tanaman atau cara kerjanya, sehingga sedikit yang mencarinya. Menjangkau mereka satu per satu lambat dan mahal.</p></div><div style="background: #FFFFFF; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></div><h3 style="font-size: 19px; font-weight: 800">Biaya operasional tinggi</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Mendaftarkan, memverifikasi dan melayani ribuan polis kecil secara manual sering memakan biaya lebih besar dari premi yang masuk. Penanggung merugi, atau premi menjadi terlalu mahal bagi petani.</p></div><div style="background: #FFFFFF; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"></path><path d="M9 15l2 2 4-4"></path></svg></div><h3 style="font-size: 19px; font-weight: 800">Klaim dan pencairan lambat</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Klaim kertas, kunjungan lapangan dan pemeriksaan manual menunda pencairan tepat saat petani paling butuh dana.</p></div></div>
<div style="margin-top: 20px; background: #003143; color: #FFFFFF; border-radius: 18px; padding: 28px 30px; display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: center">
<h3 style="flex: 1 1 300px; font-size: 26px; line-height: 1.2; font-weight: 800; color: #FFFFFF">Solusinya: asuransi di dalam ekosistem</h3>
<p style="flex: 2 1 460px; font-size: 17px; line-height: 1.6; color: #ECF9FE">Saat asuransi menjadi bagian dari alur perdagangan, keuangan dan rantai pasok yang sudah dipakai petani, didukung infrastruktur digital dan data transaksi nyata, masalah-masalah ini hilang. Petani lebih terlindungi, risiko bagi penanggung dan pemberi dana turun, dan program bisa berkembang serta berkelanjutan.</p>
</div>
<div style="margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px"><p style="font-size: 18px; font-weight: 700; color: #003143; flex: 0 1 auto">Ingin menjangkau lebih banyak petani dengan biaya lebih rendah?</p><a href="#partner" style="background: #FDB022; color: #003143; text-decoration: none; font-weight: 800; font-size: 16px; padding: 13px 22px; border-radius: 10px; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Kirim pertanyaan</a><a href="https://wa.me/6285157570025?text=Halo%20PasarMIKRO%2C%20saya%20ingin%20membahas%20asuransi%20terintegrasi.%20%28Dikirim%20dari%20halaman%20asuransi%20terintegrasi%29" target="_blank" rel="noopener" style="color: #006386; font-weight: 700; font-size: 15px; min-height: 44px; display: inline-flex; align-items: center">atau chat lewat WhatsApp</a></div>
</div>
</section>

<!-- PLATFORM -->
<section id="layanan" style="padding: 96px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="font-size: 15px; font-weight: 700; color: #006386">Yang kami lakukan</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #003143; max-width: 780px">Satu platform yang tidak terikat penanggung untuk seluruh siklus asuransi</h2>
<p style="font-size: 18px; line-height: 1.65; color: #475467; margin-top: 18px; max-width: 760px">Kami merancang, menjalankan dan mengelola alur kerja digital dan operasional lapangan di sekitar polis. Perusahaan asuransi tetap memegang produk, ketentuan dan underwriting.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; margin-top: 40px"><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M17 11l2 2 4-4"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Pendaftaran dan verifikasi petani</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Pendaftaran petani secara digital, verifikasi identitas (KYC) dan validasi data, berkoordinasi dengan kelompok tani, agregator dan koperasi.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></div><h3 style="font-size: 20px; font-weight: 800">Pemetaan lahan dan cakupan</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Tim lapangan kami membantu petani memetakan lahannya, sehingga luas yang diasuransikan sesuai lahan yang benar-benar digarap, dan memperbarui status cakupan selama musim tanam.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"></path><path d="M9 15l2 2 4-4"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Penerimaan dan verifikasi klaim</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Pengajuan klaim digital, pemantauan batas waktu dan kelengkapan, serta verifikasi dengan data agronomi, perangkat pertanian atau pemeriksaan lapangan, terdokumentasi untuk penanggung.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="13" rx="2"></rect><path d="M2 10h20"></path><path d="M6 15h4"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Penyaluran pencairan klaim</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Klaim yang disetujui langsung dicairkan ke rekening petani, lengkap dengan rekonsiliasi dan laporan pembayaran untuk penanggung.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Dasbor dan pelaporan</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Dasbor langsung untuk perusahaan asuransi, program dan pemberi dana: petani aktif, produksi, dan premi dibanding klaim, serta pelaporan donor.</p></div><div style="border: 1px solid #EAECF0; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 12px"><div style="width: 44px; height: 44px; border-radius: 12px; background: #ECF9FE; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="2.5"></circle><circle cx="5" cy="19" r="2.5"></circle><circle cx="19" cy="19" r="2.5"></circle><path d="M12 7.5v4M12 11.5l-5.5 5.5M12 11.5l5.5 5.5"></path></svg></div><h3 style="font-size: 20px; font-weight: 800">Berdiri di atas jaringan dagang yang aktif</h3><p style="font-size: 15px; line-height: 1.6; color: #475467">Petani sudah berdagang, menerima pembayaran dan memetakan lahan di PasarMIKRO untuk ketertelusuran dan EUDR, sehingga asuransi tersambung ke data yang sudah ada.</p></div></div>
<div style="margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px"><p style="font-size: 18px; font-weight: 700; color: #003143; flex: 0 1 auto">Butuh satu atau beberapa layanan ini?</p><a href="#partner" style="background: #FDB022; color: #003143; text-decoration: none; font-weight: 800; font-size: 16px; padding: 13px 22px; border-radius: 10px; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Kirim pertanyaan</a><a href="https://wa.me/6285157570025?text=Halo%20PasarMIKRO%2C%20saya%20ingin%20membahas%20asuransi%20terintegrasi.%20%28Dikirim%20dari%20halaman%20asuransi%20terintegrasi%29" target="_blank" rel="noopener" style="color: #006386; font-weight: 700; font-size: 15px; min-height: 44px; display: inline-flex; align-items: center">atau chat lewat WhatsApp</a></div>
</div>
</section>

<!-- HOW IT WORKS -->
<section id="how" style="background: #003143; color: #FFFFFF; padding: 96px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">Cara kerja</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #FFFFFF; max-width: 780px">Cara kerja asuransi tanaman terintegrasi di PasarMIKRO</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-top: 40px"><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">01</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Daftar dan verifikasi</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Petani didaftarkan dan diverifikasi secara digital, sering lewat kelompoknya atau pedagang tempat mereka biasa menjual.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">02</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Petakan dan tanggung</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Lahan dipetakan dan dibagikan ke penanggung, yang menetapkan produk, ketentuan dan premi.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">03</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Pantau musim tanam</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Cakupan dipantau sepanjang musim dan diperbarui jika luas lahan yang digarap berubah.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">04</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Klaim</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Setelah terjadi kerugian, klaim diajukan secara digital dan diverifikasi dengan data lapangan, agronomi atau perangkat.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">05</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Pencairan</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Penanggung menyetujui klaim dan dana masuk ke rekening petani, lengkap dengan rekonsiliasi.</p></div></div>
