---
// Keeps the consultation button in reach on the long EUDR page: a bar slides in once the hero's
// button has scrolled away and slides out again while the contact form itself is on screen.
import { site } from '../../lib/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** Whole days until EUDR applies to large and medium operators (30 Dec 2026); 0 or less once it applies. */
  daysLeft: number;
}
const { locale, daysLeft } = Astro.props;

const c = {
  en: {
    label: 'Book an EUDR consultation',
    region: 'Quick contact',
    countdown: daysLeft > 1 ? `EUDR applies in ${daysLeft} days` : daysLeft === 1 ? 'EUDR applies tomorrow' : 'EUDR now applies',
    sub: 'Large and medium operators, from 30 Dec 2026',
    wa: 'Chat with our EUDR team on WhatsApp',
    waText: 'Hi PasarMIKRO, I would like an EUDR consultation for my coffee or cocoa business.',
  },
  id: {
    label: 'Pesan konsultasi EUDR',
    region: 'Kontak cepat',
    countdown: daysLeft > 1 ? `EUDR berlaku dalam ${daysLeft} hari` : daysLeft === 1 ? 'EUDR berlaku besok' : 'EUDR sudah berlaku',
    sub: 'Operator besar dan menengah, mulai 30 Des 2026',
    wa: 'Chat dengan tim EUDR kami di WhatsApp',
    waText: 'Halo PasarMIKRO, saya ingin konsultasi EUDR untuk usaha kopi atau kakao saya.',
  },
}[locale];
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(c.waText)}`;
---

<aside class="eudr-sticky" data-sticky-cta aria-label={c.region} inert>
  <div class="eudr-sticky__inner">
    <div class="eudr-sticky__count">
      <strong>{c.countdown}</strong>
      <span>{c.sub}</span>
    </div>
    <a href="#contact-form" class="eudr-sticky__btn" data-cta="sticky">{c.label}</a>
    <a href={waHref} target="_blank" rel="noopener" class="eudr-sticky__wa" data-cta="sticky-whatsapp" aria-label={c.wa} title={c.wa}>
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"></path></svg>
    </a>
  </div>
</aside>

<style is:global>
  .eudr-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 35;
    padding: 0 16px calc(12px + env(safe-area-inset-bottom));
    transform: translateY(120%);
    transition: transform 0.25s ease;
    pointer-events: none;
  }
  html[data-cta-bar='on'] .eudr-sticky {
    transform: none;
  }
  .eudr-sticky__inner {
    pointer-events: auto;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #003143;
    color: #ffffff;
    border-radius: 14px;
    padding: 10px 10px 10px 18px;
    box-shadow: 0 12px 32px rgba(0, 49, 67, 0.35);
  }
  .eudr-sticky__count {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .eudr-sticky__count strong {
    font-size: 15px;
    font-weight: 700;
  }
  .eudr-sticky__count span {
    font-size: 12px;
    color: #c0e5f2;
  }
  .eudr-sticky__btn {
    flex: none;
    background: #fdb022;
    color: #003143;
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 10px;
    min-height: 44px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .eudr-sticky__btn:hover {
    background: #fec84b;
    color: #003143;
  }
  .eudr-sticky__wa {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: #128c7e;
    color: #ffffff;
  }
  .eudr-sticky__wa:hover {
    color: #ffffff;
    background: #0f7a6e;
  }
  /* The bar carries its own WhatsApp link, so the site-wide floating button steps aside while it shows. */
  html[data-cta-bar='on'] [data-wa-float] {
    opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 560px) {
    .eudr-sticky {
      padding: 0 0 env(safe-area-inset-bottom);
    }
    .eudr-sticky__inner {
      border-radius: 0;
      padding: 10px 12px;
    }
    .eudr-sticky__count {
      display: none;
    }
    .eudr-sticky__btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eudr-sticky {
      transition: none;
    }
  }
</style>

<script>
  // Show the bar when the hero button is off screen and the contact form is not on screen.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('[data-cta="hero"]');
  const form = document.getElementById('contact-form')?.closest('section');
  if (bar && hero && form && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let formVisible = false;
    const update = () => {
      const on = !heroVisible && !formVisible;
      document.documentElement.dataset.ctaBar = on ? 'on' : 'off';
      if (on) bar.removeAttribute('inert');
      else bar.setAttribute('inert', '');
    };
    new IntersectionObserver(([e]) => {
      heroVisible = e.isIntersecting;
      update();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      formVisible = e.isIntersecting;
      update();
    }).observe(form);
  }

  // Count clicks on the page's calls to action, so GA4 shows which ones lead to the form.
  type Gtag = (...args: unknown[]) => void;
  document.addEventListener('click', (e) => {
    const el = (e.target as Element | null)?.closest<HTMLElement>('[data-cta]');
    const gtag = (window as unknown as { gtag?: Gtag }).gtag;
    if (el && gtag) gtag('event', 'cta_click', { page: 'eudr', cta_location: el.dataset.cta });
  });
</script>
