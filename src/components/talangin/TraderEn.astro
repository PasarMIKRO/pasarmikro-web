---
// Talangin landing page for traders and processors (EN). Generated from the approved
// design (Talangin canvas, internal review of 3 Nov 2026); keep the wording rules in the PR description.
import { env } from 'cloudflare:workers';

export interface ProofItem {
  value: string;
  unit?: string;
  label: string;
}
interface Props {
  proof: ProofItem[];
  proofLabel: string;
  buyersHref: string;
  returnTo: string;
}
const { proof, proofLabel, buyersHref, returnTo } = Astro.props;
const siteKey = env.TURNSTILE_SITE_KEY;
---

<div class="talangin" style="background: #FFFFFF; color: #101828; width: 100%; overflow-x: hidden">
<!-- HERO + QUOTE -->
<section id="quote" style="background: radial-gradient(120% 140% at 30% 20%, #006386 0%, #004259 55%, #003143 100%); color: #FFFFFF; padding: 64px 0 88px">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
<div style="flex: 1 1 500px; min-width: 0; display: flex; flex-direction: column; gap: 24px; padding-top: 12px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">Talangin · For commodity traders and processors</div>
<h1 style="font-size: 52px; line-height: 1.07; font-weight: 800; letter-spacing: -0.03em; color: #FFFFFF">We pay your suppliers upfront. You reimburse us when your buyer pays.</h1>
<p style="font-size: 19px; line-height: 1.6; color: #C0E5F2; max-width: 560px">Talangin provides trade credit to Indonesian agricultural commodity traders and processors. PasarMIKRO pays your suppliers upfront, up to 75% of your buyer's purchase order. You reimburse us when your buyer pays. The fee depends on the agreed payment terms.</p>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px"><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 20px; font-weight: 800; color: #FFFFFF">Up to 75%</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">of your buyer's purchase order or contract</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 20px; font-weight: 800; color: #FFFFFF">Paid upfront</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">straight to your supplier's bank account</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 20px; font-weight: 800; color: #FFFFFF">Clear fee</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">based on the agreed payment terms</div></div></div>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a href="#how" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 22px; border-radius: 10px; border: 1.5px solid #2E7290; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">See how it works</a>
<a href={buyersHref} style="color: #FDB022; font-weight: 700; font-size: 16px; padding: 15px 4px; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Are you a corporate buyer? →</a>
</div>
</div>


<form id="quote-form" data-talangin-quote method="post" action="/api/contact" novalidate style="flex: 1 1 420px; min-width: 0; max-width: 520px; background: #FFFFFF; color: #101828; border-radius: 20px; padding: 28px; box-shadow: 0 24px 60px rgba(0,0,0,0.30); display: flex; flex-direction: column; gap: 16px" aria-labelledby="quote-title">
<input type="hidden" name="source" value="talangin"><input type="hidden" name="locale" value="en"><input type="hidden" name="return_to" value={returnTo}>
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap">
<h2 id="quote-title" style="font-size: 22px; font-weight: 800; letter-spacing: -0.01em">Get a quote</h2>
<span style="font-size: 12px; font-weight: 700; color: #006386; background: #ECF9FE; padding: 5px 10px; border-radius: 999px">Free · no commitment</span>
</div>
<div data-quote-fields style="display: flex; flex-direction: column; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 6px"><label for="q-po" style="font-size: 14px; font-weight: 700">Your buyer's purchase order value (Rp)</label><input id="q-po" name="po" type="text" inputmode="numeric" required placeholder="e.g. 500,000,000" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%; font-size: 18px; font-weight: 600"></div>
<div style="display: flex; flex-direction: column; gap: 6px"><label for="q-commodity" style="font-size: 14px; font-weight: 700">Commodity</label><select id="q-commodity" name="commodity" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"><option value="coffee">Coffee</option><option value="cocoa">Cocoa</option><option value="rice">Rice</option><option value="corn">Corn</option><option value="fishery">Fishery products</option><option value="other">Other</option></select></div>
<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><label for="q-term" style="font-size: 14px; font-weight: 700">Your buyer's payment term</label><output for="q-term" data-term-out style="font-size: 22px; font-weight: 800; color: #006386">14 days</output></div>
<input id="q-term" name="term" type="range" min="3" max="45" step="1" value="14" style="width: 100%; height: 44px; margin: 0; accent-color: #006386; cursor: pointer">
<div aria-hidden="true" style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #475467"><span>3 days</span><span>45 days</span></div>
</div>
<div style="background: #ECF9FE; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap"><span style="font-size: 14px; color: #475467">Paid upfront to your supplier (up to 75% of PO)</span><output data-advance-out style="font-size: 24px; font-weight: 800; color: #006386">Rp –</output></div>
<div style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap"><span style="color: #475467">Paid to</span><span style="font-weight: 700">Your supplier, upfront</span></div>
<div style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap"><span style="color: #475467">You reimburse us</span><span style="font-weight: 700">When your buyer pays</span></div>
<div style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap"><span style="color: #475467">Fee</span><span style="font-weight: 700">Depends on the payment term; shown in your quote</span></div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-name" style="font-size: 14px; font-weight: 700">Your name</label><input id="q-name" name="name" type="text" required autocomplete="name" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-company" style="font-size: 14px; font-weight: 700">Company (optional)</label><input id="q-company" name="company" type="text" autocomplete="organization" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-phone" style="font-size: 14px; font-weight: 700">WhatsApp / phone</label><input id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="08xx xxxx xxxx" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-email" style="font-size: 14px; font-weight: 700">Email</label><input id="q-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
</div>
<div class="cf-turnstile" data-sitekey={siteKey} data-language="en" data-size="flexible"></div>
<button type="submit" style="font: inherit; font-weight: 800; font-size: 17px; background: #FDB022; color: #003143; border: 0; border-radius: 10px; padding: 16px; min-height: 52px; cursor: pointer">Get my quote</button>
<p style="font-size: 12px; line-height: 1.5; color: #475467">We save your request and our Talangin team contacts you within one working day. Leave a WhatsApp number, an email, or both. Final terms depend on your buyer and documents.</p>
</div>
<p role="status" data-form-status hidden></p>
<div data-quote-done hidden style="display: flex; flex-direction: column; gap: 14px">
<div style="width: 48px; height: 48px; border-radius: 999px; background: #ECF9FE; display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg></div>
<h3 style="font-size: 22px; font-weight: 800">Thank you, we have your request</h3>
<p style="font-size: 16px; line-height: 1.6; color: #475467">Our Talangin team will contact you within one working day. For a faster reply, send your request on WhatsApp (+62 851-5757-0025) or email tika@pasarmikro.id.</p>
<a data-quote-wa href="https://wa.me/6285157570025" target="_blank" rel="noopener" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; background: #128C7E; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 16px; padding: 14px 20px; border-radius: 10px; min-height: 48px; box-sizing: border-box"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"></path></svg>Send on WhatsApp</a>
</div>
</form>
</div>
</section>

<section aria-label={proofLabel} style="background: #FFFFFF; border-bottom: 1px solid #EAECF0">
<dl style="max-width: 1200px; margin: 0 auto; padding: 36px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px">
{proof.map((p) => (<div style="display: flex; flex-direction: column-reverse; gap: 4px"><dt style="font-size: 14px; color: #475467">{p.label}</dt><dd style="margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: #006386">{p.value}{p.unit && <span style="font-size: 16px; font-weight: 600; color: #475467; margin-left: 6px">{p.unit}</span>}</dd></div>))}
</dl>
</section>
<!-- CASH GAP -->
<section id="cash-gap" style="padding: 96px 0; background: #ECF9FE">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="max-width: 800px">
<div style="font-size: 15px; font-weight: 700; color: #006386">The cash gap</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #003143; max-width: 780px">You pay your suppliers today. Your buyer pays days or weeks later.</h2>
<p style="font-size: 18px; line-height: 1.65; color: #475467; margin-top: 18px">As a trader or processor, you buy from your suppliers and deliver to your buyer. Your suppliers want to be paid when they hand over the goods; your buyer pays on its own payment terms. Until then, your working capital is tied up and you cannot buy the next load.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 40px"><div style="background: #FFFFFF; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #006386">DAY 0</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #003143">You buy from your suppliers against your buyer's purchase order</p></div><div style="background: #FFFFFF; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #006386">DAY 0–5</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #003143">Your truck arrives at the buyer's warehouse for weighing and quality checks</p></div><div style="background: #FFFFFF; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #006386">DAY 2–7</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #003143">Your buyer processes payment, unless it falls on a weekend or public holiday</p></div><div style="background: #003143; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #FDB022">WITH TALANGIN</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #ECF9FE">PasarMIKRO pays your supplier upfront, so you can keep buying</p></div></div>
<div style="margin-top: 20px; background: #FFFFFF; border-radius: 16px; padding: 26px 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; border-left: 6px solid #FDB022">
<div style="font-size: 44px; font-weight: 800; letter-spacing: -0.03em; color: #006386">~7 days</div>
<p style="flex: 1 1 360px; font-size: 17px; line-height: 1.55">is a typical gap between paying suppliers and being paid by the buyer in coffee, one of the commodities where Talangin is used today. With Talangin, PasarMIKRO pays your supplier upfront and you reimburse us when your buyer pays.</p>
</div>

<div style="margin-top: 20px; background: #FFFFFF; border-radius: 16px; padding: 32px 28px 24px">
<div style="display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: flex-end; justify-content: space-between">
<div style="flex: 1 1 500px; min-width: 0">
<div style="font-size: 15px; font-weight: 700; color: #006386">Seasonality</div>
<h3 style="font-size: 28px; line-height: 1.2; font-weight: 800; letter-spacing: -0.02em; margin-top: 10px">High season is when the most working capital is tied up</h3>
</div>
<p style="flex: 1 1 420px; font-size: 16px; line-height: 1.6; color: #475467">In coffee, for example, robusta in Lampung and southern Sumatra is harvested from around April and peaks in June and July. In high season you buy more from your suppliers, faster, so more of your working capital waits on buyer payments. Because PasarMIKRO pays your suppliers upfront for each purchase order, you can keep buying through the high season.</p>
</div>
<div style="overflow-x: auto; margin-top: 20px">
<svg viewBox="0 0 1100 345" role="img" aria-label="Curve of the robusta coffee harvest in Lampung: low season from October to March, rising from April, high season from May to August with a peak in June and July." style="width: 100%; min-width: 680px; height: auto; display: block; font-family: inherit">
<defs><linearGradient id="harv-en" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#006386" stop-opacity="0.28"></stop><stop offset="1" stop-color="#006386" stop-opacity="0.02"></stop></linearGradient></defs>
<rect x="50.0" y="44" width="255.0" height="256" rx="10" fill="#F2F4F7"></rect><rect x="391.0" y="44" width="344.0" height="256" rx="10" fill="#FEF0C7"></rect><rect x="821.0" y="44" width="255.0" height="256" rx="10" fill="#F2F4F7"></rect>
<line x1="50" x2="1076" y1="250" y2="250" stroke="#EAECF0"></line><line x1="50" x2="1076" y1="200" y2="200" stroke="#EAECF0"></line><line x1="50" x2="1076" y1="150" y2="150" stroke="#EAECF0"></line>
<line x1="50" x2="1076" y1="300" y2="300" stroke="#98A2B3" stroke-width="1.5"></line>
<text x="50" y="30" font-size="13" font-weight="600" fill="#475467">Harvest volume ↑</text>
<path d="M90.0,288.0 C104.3,288.7 147.3,293.0 176.0,292.0 C204.7,291.0 233.3,291.3 262.0,282.0 C290.7,272.7 319.3,255.0 348.0,236.0 C376.7,217.0 405.3,189.0 434.0,168.0 C462.7,147.0 491.3,121.3 520.0,110.0 C548.7,98.7 577.3,93.0 606.0,100.0 C634.7,107.0 663.3,132.0 692.0,152.0 C720.7,172.0 749.3,201.3 778.0,220.0 C806.7,238.7 835.3,254.0 864.0,264.0 C892.7,274.0 921.3,276.0 950.0,280.0 C978.7,284.0 1021.7,286.7 1036.0,288.0 L1036.0,300 L90.0,300 Z" fill="url(#harv-en)"></path>
<path d="M90.0,288.0 C104.3,288.7 147.3,293.0 176.0,292.0 C204.7,291.0 233.3,291.3 262.0,282.0 C290.7,272.7 319.3,255.0 348.0,236.0 C376.7,217.0 405.3,189.0 434.0,168.0 C462.7,147.0 491.3,121.3 520.0,110.0 C548.7,98.7 577.3,93.0 606.0,100.0 C634.7,107.0 663.3,132.0 692.0,152.0 C720.7,172.0 749.3,201.3 778.0,220.0 C806.7,238.7 835.3,254.0 864.0,264.0 C892.7,274.0 921.3,276.0 950.0,280.0 C978.7,284.0 1021.7,286.7 1036.0,288.0" fill="none" stroke="#006386" stroke-width="4" stroke-linecap="round"></path>
<text x="177.5" y="70" text-anchor="middle" font-size="15" font-weight="800" fill="#2E7290">Low season</text><text x="177.5" y="88" text-anchor="middle" font-size="12.5" font-weight="600" fill="#475467">Jan–Mar</text>
<text x="563.0" y="70" text-anchor="middle" font-size="15" font-weight="800" fill="#003143">High season</text><text x="563.0" y="88" text-anchor="middle" font-size="12.5" font-weight="600" fill="#93370D">May–Aug · peak Jun–Jul</text>
<text x="948.5" y="70" text-anchor="middle" font-size="15" font-weight="800" fill="#2E7290">Low season</text><text x="948.5" y="88" text-anchor="middle" font-size="12.5" font-weight="600" fill="#475467">Oct–Dec</text>
<circle cx="606" cy="100.0" r="7" fill="#FDB022" stroke="#003143" stroke-width="2.5"></circle>
<line x1="616" y1="100.0" x2="642" y2="100.0" stroke="#003143" stroke-width="1.5"></line><text x="648" y="105.0" font-size="14" font-weight="700" fill="#003143">Most cash tied up</text>
<text x="90" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Jan</text><text x="176" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Feb</text><text x="262" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Mar</text><text x="348" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Apr</text><text x="434" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">May</text><text x="520" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Jun</text><text x="606" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Jul</text><text x="692" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Aug</text><text x="778" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Sep</text><text x="864" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Oct</text><text x="950" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Nov</text><text x="1036" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Dec</text>
</svg>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 10px; font-size: 12px; line-height: 1.5; color: #475467">
<span><span style="display: inline-block; width: 18px; height: 4px; background: #006386; border-radius: 2px; vertical-align: middle; margin-right: 6px"></span>Example: indicative robusta harvest volume, Lampung (not to scale)</span>
<span>Timing: harvest starts around April and peaks in June–July (Indonesia Coffee Exporters Association, via The Jakarta Post).</span>
</div>
</div>

</div>
</section>

<!-- HOW IT WORKS -->
<section id="how" style="background: #003143; color: #FFFFFF; padding: 96px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">How Talangin works</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #FFFFFF; max-width: 780px">How Talangin works for traders and processors</h2>
<p style="font-size: 17px; line-height: 1.6; color: #C0E5F2; margin-top: 16px; max-width: 760px">Three parties, one clear flow: your supplier, you as the trader or processor, and your buyer.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-top: 40px"><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">01</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Your buyer's PO</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Your buyer issues a purchase order or contract for the goods you will deliver.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">02</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Verification</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">PasarMIKRO verifies the purchase order and delivery details directly with your buyer.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">03</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">Your supplier is paid</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">PasarMIKRO pays your supplier upfront, up to 75% of the purchase order.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">04</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">You deliver</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">You deliver the goods to your buyer as agreed.</p></div><div style="background: #004259; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 10px"><div style="font-size: 15px; font-weight: 600; color: #FDB022">05</div><h3 style="font-size: 18px; font-weight: 700; color: #FFFFFF">You reimburse us</h3><p style="font-size: 15px; line-height: 1.6; color: #C0E5F2">Your buyer pays into your PasarMIKRO account on the agreed date, and you reimburse PasarMIKRO from that payment, including the agreed fee.</p></div></div>
