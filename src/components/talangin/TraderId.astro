---
// Talangin landing page for traders and processors (ID). Generated from the approved
// design (Talangin canvas, internal review of 3 Nov 2026); keep the wording rules in the PR description.
import { env } from 'cloudflare:workers';

export interface ProofItem {
  value: string;
  unit?: string;
  label: string;
}
interface Props {
  proof: ProofItem[];
  proofLabel: string;
  buyersHref: string;
  returnTo: string;
}
const { proof, proofLabel, buyersHref, returnTo } = Astro.props;
const siteKey = env.TURNSTILE_SITE_KEY;
---

<div class="talangin" style="background: #FFFFFF; color: #101828; width: 100%; overflow-x: hidden">
<!-- HERO + QUOTE -->
<section id="penawaran" style="background: radial-gradient(120% 140% at 30% 20%, #006386 0%, #004259 55%, #003143 100%); color: #FFFFFF; padding: 64px 0 88px">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
<div style="flex: 1 1 500px; min-width: 0; display: flex; flex-direction: column; gap: 24px; padding-top: 12px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">Talangin · Untuk pedagang dan pengolah komoditas</div>
<h1 style="font-size: 52px; line-height: 1.07; font-weight: 800; letter-spacing: -0.03em; color: #FFFFFF">Kami bayar pemasok Anda di muka. Anda membayar kami setelah pembeli Anda membayar.</h1>
<p style="font-size: 19px; line-height: 1.6; color: #C0E5F2; max-width: 560px">Talangin menyediakan kredit dagang bagi pedagang dan pengolah komoditas pertanian di Indonesia. PasarMIKRO membayar pemasok Anda di muka, hingga 75% dari nilai purchase order pembeli Anda. Anda membayar kami setelah pembeli Anda membayar. Biaya layanan tergantung pada kesepakatan.</p>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px"><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 20px; font-weight: 800; color: #FFFFFF">Hingga 75%</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">dari purchase order atau kontrak pembeli</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 20px; font-weight: 800; color: #FFFFFF">Dibayar di muka</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">langsung ke rekening bank pemasok Anda</div></div><div style="border-top: 2px solid #FDB022; padding-top: 12px"><div style="font-size: 20px; font-weight: 800; color: #FFFFFF">Biaya layanan jelas</div><div style="font-size: 13px; line-height: 1.45; color: #98A2B3; margin-top: 4px">tergantung pada kesepakatan</div></div></div>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a href="#cara-kerja" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 22px; border-radius: 10px; border: 1.5px solid #2E7290; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Lihat cara kerjanya</a>
<a href={buyersHref} style="color: #FDB022; font-weight: 700; font-size: 16px; padding: 15px 4px; min-height: 48px; box-sizing: border-box; display: inline-flex; align-items: center">Anda pembeli korporat? →</a>
</div>
</div>


<form id="quote-form" data-talangin-quote method="post" action="/api/contact" novalidate style="flex: 1 1 420px; min-width: 0; max-width: 520px; background: #FFFFFF; color: #101828; border-radius: 20px; padding: 28px; box-shadow: 0 24px 60px rgba(0,0,0,0.30); display: flex; flex-direction: column; gap: 16px" aria-labelledby="quote-title">
<input type="hidden" name="source" value="talangin"><input type="hidden" name="locale" value="id"><input type="hidden" name="return_to" value={returnTo}>
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap">
<h2 id="quote-title" style="font-size: 22px; font-weight: 800; letter-spacing: -0.01em">Minta penawaran</h2>
<span style="font-size: 12px; font-weight: 700; color: #006386; background: #ECF9FE; padding: 5px 10px; border-radius: 999px">Gratis · tanpa komitmen</span>
</div>
<div data-quote-fields style="display: flex; flex-direction: column; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 6px"><label for="q-po" style="font-size: 14px; font-weight: 700">Nilai purchase order pembeli (Rp)</label><input id="q-po" name="po" type="text" inputmode="numeric" required placeholder="contoh: 500.000.000" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%; font-size: 18px; font-weight: 600"></div>
<div style="display: flex; flex-direction: column; gap: 6px"><label for="q-commodity" style="font-size: 14px; font-weight: 700">Komoditas</label><select id="q-commodity" name="commodity" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"><option value="coffee">Kopi</option><option value="cocoa">Kakao</option><option value="rice">Beras</option><option value="corn">Jagung</option><option value="fishery">Hasil perikanan</option><option value="other">Lainnya</option></select></div>
<div style="display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><label for="q-term" style="font-size: 14px; font-weight: 700">Tenor pembayaran pembeli</label><output for="q-term" data-term-out style="font-size: 22px; font-weight: 800; color: #006386">14 hari</output></div>
<input id="q-term" name="term" type="range" min="3" max="45" step="1" value="14" style="width: 100%; height: 44px; margin: 0; accent-color: #006386; cursor: pointer">
<div aria-hidden="true" style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #475467"><span>3 hari</span><span>45 hari</span></div>
</div>
<div style="background: #ECF9FE; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap"><span style="font-size: 14px; color: #475467">Dibayar di muka ke pemasok (hingga 75% dari nilai PO)</span><output data-advance-out style="font-size: 24px; font-weight: 800; color: #006386">Rp –</output></div>
<div style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap"><span style="color: #475467">Dibayar ke</span><span style="font-weight: 700">Pemasok Anda, di muka</span></div>
<div style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap"><span style="color: #475467">Anda membayar kami</span><span style="font-weight: 700">Setelah pembeli Anda membayar</span></div>
<div style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; flex-wrap: wrap"><span style="color: #475467">Biaya layanan</span><span style="font-weight: 700">Sesuai kesepakatan; tercantum di penawaran</span></div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-name" style="font-size: 14px; font-weight: 700">Nama Anda</label><input id="q-name" name="name" type="text" required autocomplete="name" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-company" style="font-size: 14px; font-weight: 700">Perusahaan (opsional)</label><input id="q-company" name="company" type="text" autocomplete="organization" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-phone" style="font-size: 14px; font-weight: 700">WhatsApp / telepon</label><input id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="08xx xxxx xxxx" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px"><label for="q-email" style="font-size: 14px; font-weight: 700">Email</label><input id="q-email" name="email" type="email" autocomplete="email" placeholder="anda@perusahaan.com" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #98A2B3; border-radius: 10px; background: #FFFFFF; min-height: 48px; box-sizing: border-box; width: 100%"></div>
</div>
<div class="cf-turnstile" data-sitekey={siteKey} data-language="id" data-size="flexible"></div>
<button type="submit" style="font: inherit; font-weight: 800; font-size: 17px; background: #FDB022; color: #003143; border: 0; border-radius: 10px; padding: 16px; min-height: 52px; cursor: pointer">Kirim penawaran saya</button>
<p style="font-size: 12px; line-height: 1.5; color: #475467">Permintaan Anda kami simpan dan tim Talangin kami menghubungi Anda dalam satu hari kerja. Isi nomor WhatsApp, email, atau keduanya. Ketentuan akhir bergantung pada pembeli dan dokumen Anda.</p>
</div>
<p role="status" data-form-status hidden></p>
<div data-quote-done hidden style="display: flex; flex-direction: column; gap: 14px">
<div style="width: 48px; height: 48px; border-radius: 999px; background: #ECF9FE; display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#006386" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg></div>
<h3 style="font-size: 22px; font-weight: 800">Terima kasih, permintaan Anda sudah kami terima</h3>
<p style="font-size: 16px; line-height: 1.6; color: #475467">Tim Talangin kami akan menghubungi Anda dalam satu hari kerja. Untuk balasan lebih cepat, kirim permintaan Anda lewat WhatsApp (+62 851-5757-0025) atau email tika@pasarmikro.id.</p>
<a data-quote-wa href="https://wa.me/6285157570025" target="_blank" rel="noopener" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; background: #128C7E; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 16px; padding: 14px 20px; border-radius: 10px; min-height: 48px; box-sizing: border-box"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"></path></svg>Kirim lewat WhatsApp</a>
</div>
</form>
</div>
</section>

<section aria-label={proofLabel} style="background: #FFFFFF; border-bottom: 1px solid #EAECF0">
<dl style="max-width: 1200px; margin: 0 auto; padding: 36px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px">
{proof.map((p) => (<div style="display: flex; flex-direction: column-reverse; gap: 4px"><dt style="font-size: 14px; color: #475467">{p.label}</dt><dd style="margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: #006386">{p.value}{p.unit && <span style="font-size: 16px; font-weight: 600; color: #475467; margin-left: 6px">{p.unit}</span>}</dd></div>))}
</dl>
</section>
<!-- CASH GAP -->
<section id="celah-kas" style="padding: 96px 0; background: #ECF9FE">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="max-width: 800px">
<div style="font-size: 15px; font-weight: 700; color: #006386">Celah kas</div>
<h2 style="font-size: 40px; line-height: 1.12; font-weight: 800; letter-spacing: -0.025em; margin-top: 14px; color: #003143; max-width: 780px">Anda membayar pemasok hari ini. Pembeli membayar beberapa hari atau minggu kemudian.</h2>
<p style="font-size: 18px; line-height: 1.65; color: #475467; margin-top: 18px">Sebagai pedagang atau pengolah, Anda membeli dari pemasok dan mengirim ke pembeli. Pemasok ingin dibayar saat menyerahkan barang; pembeli membayar sesuai tenornya sendiri. Sampai saat itu, modal kerja Anda tertahan dan Anda tidak bisa membeli muatan berikutnya.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 40px"><div style="background: #FFFFFF; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #006386">HARI KE-0</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #003143">Anda membeli dari pemasok berdasarkan purchase order pembeli</p></div><div style="background: #FFFFFF; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #006386">HARI KE-0–5</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #003143">Truk Anda tiba di gudang pembeli untuk ditimbang dan dicek kualitasnya</p></div><div style="background: #FFFFFF; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #006386">HARI KE-2–7</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #003143">Pembeli memproses pembayaran, kecuali di akhir pekan atau hari libur</p></div><div style="background: #003143; border-radius: 14px; padding: 22px"><div style="font-size: 15px; font-weight: 700; color: #FDB022">DENGAN TALANGIN</div><p style="font-size: 16px; line-height: 1.5; margin-top: 8px; color: #ECF9FE">PasarMIKRO membayar pemasok Anda di muka, sehingga Anda bisa terus membeli</p></div></div>
<div style="margin-top: 20px; background: #FFFFFF; border-radius: 16px; padding: 26px 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; border-left: 6px solid #FDB022">
<div style="font-size: 44px; font-weight: 800; letter-spacing: -0.03em; color: #006386">~7 hari</div>
<p style="flex: 1 1 360px; font-size: 17px; line-height: 1.55">adalah jeda umum antara membayar pemasok dan menerima pembayaran pembeli di komoditas kopi, salah satu komoditas tempat Talangin digunakan saat ini. Dengan Talangin, PasarMIKRO membayar pemasok Anda di muka dan Anda membayar kami setelah pembeli Anda membayar.</p>
</div>

<div style="margin-top: 20px; background: #FFFFFF; border-radius: 16px; padding: 32px 28px 24px">
<div style="display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: flex-end; justify-content: space-between">
<div style="flex: 1 1 500px; min-width: 0">
<div style="font-size: 15px; font-weight: 700; color: #006386">Musim panen</div>
<h3 style="font-size: 28px; line-height: 1.2; font-weight: 800; letter-spacing: -0.02em; margin-top: 10px">Musim ramai adalah saat modal kerja paling banyak tertahan</h3>
</div>
<p style="flex: 1 1 420px; font-size: 16px; line-height: 1.6; color: #475467">Pada kopi, misalnya, robusta di Lampung dan Sumatra bagian selatan mulai dipanen sekitar April dan mencapai puncak pada Juni dan Juli. Di musim ramai Anda membeli lebih banyak dari pemasok, lebih cepat, sehingga lebih banyak modal kerja menunggu pembayaran pembeli. Karena PasarMIKRO membayar pemasok Anda di muka untuk setiap purchase order, Anda bisa terus membeli sepanjang musim ramai.</p>
</div>
<div style="overflow-x: auto; margin-top: 20px">
<svg viewBox="0 0 1100 345" role="img" aria-label="Kurva panen kopi robusta di Lampung: musim sepi dari Oktober hingga Maret, naik mulai April, musim ramai Mei hingga Agustus dengan puncak Juni dan Juli." style="width: 100%; min-width: 680px; height: auto; display: block; font-family: inherit">
<defs><linearGradient id="harv-id" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#006386" stop-opacity="0.28"></stop><stop offset="1" stop-color="#006386" stop-opacity="0.02"></stop></linearGradient></defs>
<rect x="50.0" y="44" width="255.0" height="256" rx="10" fill="#F2F4F7"></rect><rect x="391.0" y="44" width="344.0" height="256" rx="10" fill="#FEF0C7"></rect><rect x="821.0" y="44" width="255.0" height="256" rx="10" fill="#F2F4F7"></rect>
<line x1="50" x2="1076" y1="250" y2="250" stroke="#EAECF0"></line><line x1="50" x2="1076" y1="200" y2="200" stroke="#EAECF0"></line><line x1="50" x2="1076" y1="150" y2="150" stroke="#EAECF0"></line>
<line x1="50" x2="1076" y1="300" y2="300" stroke="#98A2B3" stroke-width="1.5"></line>
<text x="50" y="30" font-size="13" font-weight="600" fill="#475467">Volume panen ↑</text>
<path d="M90.0,288.0 C104.3,288.7 147.3,293.0 176.0,292.0 C204.7,291.0 233.3,291.3 262.0,282.0 C290.7,272.7 319.3,255.0 348.0,236.0 C376.7,217.0 405.3,189.0 434.0,168.0 C462.7,147.0 491.3,121.3 520.0,110.0 C548.7,98.7 577.3,93.0 606.0,100.0 C634.7,107.0 663.3,132.0 692.0,152.0 C720.7,172.0 749.3,201.3 778.0,220.0 C806.7,238.7 835.3,254.0 864.0,264.0 C892.7,274.0 921.3,276.0 950.0,280.0 C978.7,284.0 1021.7,286.7 1036.0,288.0 L1036.0,300 L90.0,300 Z" fill="url(#harv-id)"></path>
<path d="M90.0,288.0 C104.3,288.7 147.3,293.0 176.0,292.0 C204.7,291.0 233.3,291.3 262.0,282.0 C290.7,272.7 319.3,255.0 348.0,236.0 C376.7,217.0 405.3,189.0 434.0,168.0 C462.7,147.0 491.3,121.3 520.0,110.0 C548.7,98.7 577.3,93.0 606.0,100.0 C634.7,107.0 663.3,132.0 692.0,152.0 C720.7,172.0 749.3,201.3 778.0,220.0 C806.7,238.7 835.3,254.0 864.0,264.0 C892.7,274.0 921.3,276.0 950.0,280.0 C978.7,284.0 1021.7,286.7 1036.0,288.0" fill="none" stroke="#006386" stroke-width="4" stroke-linecap="round"></path>
<text x="177.5" y="70" text-anchor="middle" font-size="15" font-weight="800" fill="#2E7290">Musim sepi</text><text x="177.5" y="88" text-anchor="middle" font-size="12.5" font-weight="600" fill="#475467">Jan–Mar</text>
<text x="563.0" y="70" text-anchor="middle" font-size="15" font-weight="800" fill="#003143">Musim ramai</text><text x="563.0" y="88" text-anchor="middle" font-size="12.5" font-weight="600" fill="#93370D">Mei–Agu · puncak Jun–Jul</text>
<text x="948.5" y="70" text-anchor="middle" font-size="15" font-weight="800" fill="#2E7290">Musim sepi</text><text x="948.5" y="88" text-anchor="middle" font-size="12.5" font-weight="600" fill="#475467">Okt–Des</text>
<circle cx="606" cy="100.0" r="7" fill="#FDB022" stroke="#003143" stroke-width="2.5"></circle>
<line x1="616" y1="100.0" x2="642" y2="100.0" stroke="#003143" stroke-width="1.5"></line><text x="648" y="105.0" font-size="14" font-weight="700" fill="#003143">Kas paling banyak tertahan</text>
<text x="90" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Jan</text><text x="176" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Feb</text><text x="262" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Mar</text><text x="348" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Apr</text><text x="434" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Mei</text><text x="520" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Jun</text><text x="606" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Jul</text><text x="692" y="328" text-anchor="middle" font-size="15" font-weight="700" fill="#003143">Agu</text><text x="778" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Sep</text><text x="864" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Okt</text><text x="950" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Nov</text><text x="1036" y="328" text-anchor="middle" font-size="15" font-weight="500" fill="#475467">Des</text>
</svg>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 10px; font-size: 12px; line-height: 1.5; color: #475467">
<span><span style="display: inline-block; width: 18px; height: 4px; background: #006386; border-radius: 2px; vertical-align: middle; margin-right: 6px"></span>Contoh: perkiraan volume panen robusta, Lampung (tidak berskala)</span>
<span>Waktu: panen mulai sekitar April dan memuncak Juni–Juli (Asosiasi Eksportir Kopi Indonesia, via The Jakarta Post).</span>
</div>
</div>

</div>
</section>

<!-- HOW IT WORKS -->
<section id="cara-kerja" style="background: #003143; color: #FFFFFF; padding: 96px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px">
<div style="font-size: 15px; font-weight: 700; color: #FDB022">Cara kerja Talangin</div>
